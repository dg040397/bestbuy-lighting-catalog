---
const categories = [
  { 
    name: "Outdoor Light", 
    slug: "outdoor-light",
    subs: ["LED Flood Light", "LED Street Light", "LED Underwater Light", "Step Light"]
  },
  { 
    name: "Indoor Light", 
    slug: "indoor-light",
    subs: ["LED Downlight", "LED Track Light", "LED Panel Light"]
  },
  { 
    name: "LED Strip Light", 
    slug: "led-strip-light",
    subs: ["Silicone LED Neon", "COB LED Strip", "Aluminum Profile"]
  },
  { 
    name: "Solar LED Light", 
    slug: "solar-led-light",
    subs: ["Solar Street Light", "Solar Flood Light"]
  },
  { 
    name: "LED Wall Light", 
    slug: "led-wall-light",
    subs: ["Decoration Wall Light", "Mirror Light"]
  },
  { 
    name: "Commercial Light", 
    slug: "commercial-light",
    subs: ["LED High Bay Light", "Linear Light"]
  }
];
---

<aside class="w-64 bg-white border border-gray-300 self-start hidden md:block">
  <!-- Gradient Header (B2B Classic) -->
  <div class="bg-gradient-to-b from-blue-700 to-blue-900 text-white font-bold p-3 uppercase text-[13px] tracking-wide border-b border-blue-950">
    Products Categories
  </div>
  
  <ul class="flex flex-col text-[13px] font-semibold text-gray-700">
    {categories.map(cat => (
      <li class="border-b border-gray-200 bg-gray-50 group">
        <a href={`/products/${cat.slug}`} class="flex items-center px-4 py-2.5 hover:bg-blue-600 hover:text-white transition-colors border-l-2 border-transparent hover:border-blue-800">
          <span class="text-[9px] mr-2 text-gray-400 group-hover:text-blue-300">▶</span> 
          {cat.name}
        </a>
        <!-- Subcategory Dropdown (Visible on hover for that dense catalog feel) -->
        <ul class="hidden group-hover:block bg-white border-t border-gray-200 py-1">
          {cat.subs.map(sub => (
            <li>
              <a href={`/products/${cat.slug}?sub=${sub.replace(/ /g, '-')}`} class="block px-8 py-1.5 text-[12px] text-gray-600 hover:text-blue-700 hover:underline font-normal">
                - {sub}
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
  
  <!-- Factory Direct Contact Block -->
  <div class="mt-4 p-4 bg-gray-100 border-t border-gray-300 text-[12px] text-gray-700 space-y-2">
    <h4 class="font-bold text-gray-900 uppercase border-b border-gray-300 pb-1 mb-2">Factory Direct Sales</h4>
    <p><strong class="text-blue-800">Tel:</strong> +260 XX XXX XXXX</p>
    <p><strong class="text-blue-800">WhatsApp:</strong> +260 XX XXX XXXX</p>
    <p><strong class="text-blue-800">Email:</strong> sales@bestbuylighting.co.zm</p>
    <a href="/contact" class="mt-3 block text-center bg-blue-700 text-white py-1.5 font-bold hover:bg-blue-800 transition-colors">
      Send Message
    </a>
  </div>
</aside>