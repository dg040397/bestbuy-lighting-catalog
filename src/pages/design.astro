---
import Navbar from '../components/Navbar.astro';
---
<html lang="en">
  <head>
    <title>Lighting Design Services | BestBuy Lighting</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <Navbar />
    <div class="max-w-4xl mx-auto py-12 px-6">
      <h1 class="text-3xl font-bold mb-6 text-center">LED Lighting Design Services & OEM</h1>
      <div class="bg-blue-50 border border-blue-200 p-6 rounded mb-8 text-sm text-blue-900 leading-relaxed">
        <strong>Dialux Simulation & Photometric Analysis:</strong> We provide detailed lighting plans, Dialux simulations, and custom luminaire design for commercial offices, warehouses, and architectural facades.
      </div>
      <ul class="space-y-4 text-gray-700 border-l-2 border-gray-200 pl-6">
        <li><strong>Step 1:</strong> Consultation and Needs Assessment (CAD drawings, budget).</li>
        <li><strong>Step 2:</strong> Photometric Analysis (Light distribution, intensity, uniformity).</li>
        <li><strong>Step 3:</strong> Custom Luminaire Prototyping (OEM/ODM).</li>
        <li><strong>Step 4:</strong> Manufacturing and Installation Support.</li>
      </ul>
    </div>
  </body>
</html>