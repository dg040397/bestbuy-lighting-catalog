---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import data from '../../data/database.json';

export function getStaticPaths() {
  const categories = [
    { name: "Indoor Light", slug: "indoor-light" },
    { name: "Outdoor Light", slug: "outdoor-light" },
    { name: "LED Strip Light", slug: "led-strip-light" },
    { name: "Solar LED Light", slug: "solar-led-light" },
    { name: "Accessories", slug: "accessories" }
  ];

  return categories.map(cat => {
    const filteredProducts = data.products.filter(
      p => p.category.toLowerCase().replace(/ /g, '-') === cat.slug
    );
    return {
      params: { category: cat.slug },
      props: { categoryName: cat.name, products: filteredProducts }
    };
  });
}

const { categoryName, products } = Astro.props;
---

<CatalogLayout title={`${categoryName} | BestBuy Lighting`}>
  <h2 class="text-2xl font-bold border-b-2 border-blue-800 pb-2 mb-6 inline-block">{categoryName}</h2>
  
  {products.length === 0 ? (
    <div class="bg-white p-8 text-center text-gray-500 border">
      No products found in this category yet.
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {products.map(product => (
        <div class="border bg-white p-4 hover:shadow-lg transition-shadow">
          <img src={product.image} alt={product.title} class="w-full h-48 object-cover mb-4 bg-gray-100" />
          <p class="text-xs text-blue-600 font-bold mb-1">{product.category}</p>
          <h3 class="text-sm text-gray-800 h-10 mb-4 line-clamp-2">{product.title}</h3>
          <p class="text-xs text-gray-500 mb-4">Model: {product.sku}</p>
          <a href="/contact" class="block text-center bg-blue-800 text-white py-2 text-sm font-bold hover:bg-blue-700">
            Inquire Now
          </a>
        </div>
      ))}
    </div>
  )}
</CatalogLayout>