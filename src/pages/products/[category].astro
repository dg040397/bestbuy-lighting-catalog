---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import data from '../../data/database.json';

export function getStaticPaths() {
  const categories = [
    { name: "Outdoor Light", slug: "outdoor-light" },
    { name: "Indoor Light", slug: "indoor-light" },
    { name: "LED Strip Light", slug: "led-strip-light" },
    { name: "Solar LED Light", slug: "solar-led-light" },
    { name: "LED Wall Light", slug: "led-wall-light" },
    { name: "Commercial Light", slug: "commercial-light" }
  ];

  return categories.map(cat => {
    const filteredProducts = data.products.filter(
      p => p.category === cat.name
    );
    return {
      params: { category: cat.slug },
      props: { categoryName: cat.name, products: filteredProducts }
    };
  });
}

const { categoryName, products } = Astro.props;
---

<CatalogLayout title={`${categoryName} | Factory Direct - BestBuy Lighting`}>
  
  <!-- Breadcrumb -->
  <div class="text-[12px] text-gray-500 mb-4 border-b border-gray-300 pb-2">
    Home > Products > <span class="font-bold text-gray-800">{categoryName}</span>
  </div>

  <h2 class="text-xl font-bold border-l-4 border-blue-700 pl-3 mb-6 text-gray-900 uppercase tracking-wide">
    {categoryName} Series
  </h2>
  
  {products.length === 0 ? (
    <div class="bg-white p-8 text-center text-[13px] text-gray-500 border border-gray-300">
      No products found in this category yet.
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {products.map(product => (
        <div class="border border-gray-300 p-3 bg-white hover:border-blue-600 transition-colors group relative">
          
          <!-- Image Box with border -->
          <a href={`/products/detail/${product.sku.toLowerCase()}`} class="block border border-gray-100 p-1 mb-3">
            <img src={product.image} alt={product.title} class="w-full h-40 object-cover bg-gray-50" />
          </a>
          
          <!-- Subcategory Tag -->
          <p class="text-[11px] text-blue-700 font-bold mb-1 uppercase">{product.sub_category}</p>
          
          <!-- Title (Strict height for grid alignment) -->
          <a href={`/products/detail/${product.sku.toLowerCase()}`}>
            <h3 class="text-[13px] text-gray-800 h-10 overflow-hidden leading-tight group-hover:text-blue-700 hover:underline">
              {product.title}
            </h3>
          </a>
          
          <!-- SKU -->
          <p class="text-[11px] text-gray-500 my-2">Item No: <span class="font-mono text-gray-900 font-bold">{product.sku}</span></p>
          
          <!-- Action Buttons -->
          <div class="flex gap-2 mt-3">
            <a href={`/products/detail/${product.sku.toLowerCase()}`} class="flex-1 text-center bg-gray-100 border border-gray-300 text-gray-700 py-1.5 text-[12px] hover:bg-gray-200 transition-colors">
              Detail
            </a>
            <a href={`/contact?sku=${product.sku}`} class="flex-1 text-center bg-blue-700 text-white py-1.5 text-[12px] font-bold hover:bg-blue-800 transition-colors">
              Inquire
            </a>
          </div>
          
        </div>
      ))}
    </div>
  )}
</CatalogLayout>