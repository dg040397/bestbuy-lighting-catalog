---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import data from '../../data/database.json';
---

<CatalogLayout title="All Products | BestBuy Lighting">
  <h2 class="text-2xl font-bold border-b-2 border-blue-800 pb-2 mb-6 inline-block">All Products</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {data.products.map(product => (
      <div class="border bg-white p-4 hover:shadow-lg transition-shadow">
        <a href={`/products/detail/${product.sku.toLowerCase()}`}>
          <img src={product.image} alt={product.title} class="w-full h-48 object-cover mb-4 bg-gray-100" />
        </a>
        <p class="text-xs text-blue-600 font-bold mb-1">{product.category}</p>
        <h3 class="text-sm text-gray-800 h-10 mb-4 line-clamp-2 leading-snug">{product.title}</h3>
        <p class="text-xs text-gray-500 mb-4">Model: {product.sku}</p>
        <a href={`/products/detail/${product.sku.toLowerCase()}`} class="block text-center bg-blue-800 text-white py-2 text-sm font-bold hover:bg-blue-700">
          View Specifications
        </a>
      </div>
    ))}
  </div>
</CatalogLayout>