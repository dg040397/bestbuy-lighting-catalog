---
// Import the dummy data
import products from '../data/products.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Bestbuy Lighting Ltd | Digital Catalog</title>
    <!-- This single line brings in all the Tailwind CSS styles -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans">
    
    <!-- Header -->
    <header class="bg-slate-900 text-white py-6 shadow-md">
      <div class="max-w-6xl mx-auto px-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold tracking-tight">BestBuy Lighting Ltd</h1>
        <a href="mailto:sales@bestbuylighting.com" class="bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded-md font-medium transition-colors">
          Request a Quote
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-4 py-12">
      <div class="mb-8">
        <h2 class="text-3xl font-bold mb-2">Product Catalog</h2>
        <p class="text-gray-600">Browse our high-performance fixtures and technical specifications.</p>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <img src={product.image} alt={product.title} class="w-full h-64 object-cover bg-gray-100" />
            
            <div class="p-6">
              <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">{product.category}</span>
              <h3 class="text-lg font-bold mt-1 mb-2 leading-tight">{product.title}</h3>
              <p class="text-sm text-gray-500 mb-4">SKU: {product.sku}</p>
              
              <!-- Specs Table -->
              <div class="bg-gray-50 rounded border border-gray-100 p-4 mb-6">
                <ul class="text-sm space-y-2">
                  {Object.entries(product.specs).map(([key, value]) => (
                    <li class="flex justify-between border-b border-gray-200 pb-1 last:border-0 last:pb-0">
                      <span class="text-gray-500 capitalize">{key.replace('_', ' ')}:</span>
                      <span class="font-medium text-gray-900">{value}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <button class="w-full border-2 border-slate-900 text-slate-900 py-2 rounded font-semibold hover:bg-slate-900 hover:text-white transition-colors">
                View Specifications
              </button>
            </div>
          </div>
        ))}
      </div>
    </main>

  </body>
</html>