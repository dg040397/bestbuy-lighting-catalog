---
import Navbar from '../components/Navbar.astro';
---
<html lang="en">
  <head>
    <title>BestBuy Lighting Ltd | LED Manufacturer</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <Navbar />
    <!-- Hero Banner -->
    <div class="w-full h-96 bg-slate-800 flex items-center justify-center text-center">
      <div>
        <h1 class="text-4xl font-black text-white mb-4">Professional LED Lighting Solutions</h1>
        <p class="text-gray-300">Indoor • Outdoor • Solar • Custom OEM/ODM</p>
      </div>
    </div>
    
    <!-- Quick Links -->
    <div class="max-w-7xl mx-auto py-12 px-6 grid grid-cols-4 gap-6 text-center">
      <a href="/products" class="p-6 border bg-white shadow-sm hover:border-blue-600 font-bold text-gray-800">View Catalog</a>
      <a href="/projects" class="p-6 border bg-white shadow-sm hover:border-blue-600 font-bold text-gray-800">Engineering Projects</a>
      <a href="/design" class="p-6 border bg-white shadow-sm hover:border-blue-600 font-bold text-gray-800">Lighting Design</a>
      <a href="/downloads" class="p-6 border bg-white shadow-sm hover:border-blue-600 font-bold text-gray-800">Parameter Data</a>
    </div>
  </body>
</html>