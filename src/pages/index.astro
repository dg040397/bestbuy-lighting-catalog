---
import products from '../data/products.json';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BestBuy Lighting Ltd | B2B Commercial & Industrial Lighting Solutions</title>
    <!-- Tailwind CSS with is:inline directive -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <style>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in {
        animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-blue-600 selection:text-white">
    
    <!-- Navigation Bar -->
    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo -->
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center font-black text-xl shadow-lg shadow-blue-500/30">
              B
            </div>
            <div>
              <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">
                BestBuy Lighting Ltd
              </span>
              <span class="block text-xs text-blue-400 font-medium tracking-wider uppercase">Commercial & Industrial</span>
            </div>
          </div>

          <!-- Desktop Navigation Tabs -->
          <nav class="hidden md:flex items-center space-x-1">
            <a href="#hero" class="px-4 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all">Home</a>
            <a href="#catalog" class="px-4 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all">Products</a>
            <a href="#about" class="px-4 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all">About Us</a>
            <a href="#certifications" class="px-4 py-2 text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-all">Quality & Specs</a>
            <a href="#contact" class="ml-4 px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-lg shadow-lg shadow-blue-600/30 hover:shadow-blue-600/50 transition-all transform hover:-translate-y-0.5">
              Inquire Now
            </a>
          </nav>

        </div>
      </div>
    </header>

    <!-- Hero Section with Animated Gradient -->
    <section id="hero" class="relative overflow-hidden pt-20 pb-28 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(37,99,235,0.15),transparent_50%)]"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-6">
          High-Performance LED Manufacturer & Distributor
        </span>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white mb-6 leading-tight">
          Architectural, Commercial & <br class="hidden sm:block" />
          <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-400 bg-clip-text text-transparent">
            Industrial Lighting Systems
          </span>
        </h1>
        <p class="max-w-2xl mx-auto text-lg text-slate-400 mb-10">
          Engineered for reliability, energy efficiency, and long lifespan. Serving electrical contractors, commercial projects, and wholesale clients.
        </p>

        <!-- Stats Bar -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto pt-8 border-t border-slate-800/80">
          <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
            <div class="text-3xl font-black text-blue-400">50,000+</div>
            <div class="text-xs text-slate-400 mt-1">Rated Hours Lifespan</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
            <div class="text-3xl font-black text-blue-400">IP65/IP66</div>
            <div class="text-xs text-slate-400 mt-1">Outdoor Ratings</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
            <div class="text-3xl font-black text-blue-400">5 Years</div>
            <div class="text-xs text-slate-400 mt-1">Manufacturer Warranty</div>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
            <div class="text-3xl font-black text-blue-400">100%</div>
            <div class="text-xs text-slate-400 mt-1">QC Tested Fixtures</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Catalog Section -->
    <section id="catalog" class="py-20 bg-slate-950 border-t border-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <h2 class="text-3xl font-bold text-white tracking-tight">Product Showcase</h2>
            <p class="text-slate-400 mt-2">Filter by application to view technical parameters.</p>
          </div>

          <!-- Category Filter Tabs (Client-Side JS Driven) -->
          <div class="flex flex-wrap gap-2 mt-6 md:mt-0" id="filter-tabs">
            <button data-category="All" class="filter-btn px-4 py-2 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-all shadow-md shadow-blue-600/30">All Fixtures</button>
            <button data-category="Indoor" class="filter-btn px-4 py-2 rounded-lg text-sm font-semibold bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 transition-all border border-slate-800">Indoor</button>
            <button data-category="Outdoor" class="filter-btn px-4 py-2 rounded-lg text-sm font-semibold bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 transition-all border border-slate-800">Outdoor</button>
            <button data-category="Commercial" class="filter-btn px-4 py-2 rounded-lg text-sm font-semibold bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 transition-all border border-slate-800">Commercial</button>
            <button data-category="Solar" class="filter-btn px-4 py-2 rounded-lg text-sm font-semibold bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800 transition-all border border-slate-800">Solar</button>
          </div>
        </div>

        <!-- Animated Product Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="product-grid">
          {products.map((product) => (
            <div 
              data-category={product.category}
              class="product-card group bg-slate-900 rounded-2xl border border-slate-800/80 overflow-hidden hover:border-blue-500/50 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:shadow-blue-500/10 flex flex-col justify-between"
            >
              <div>
                <!-- Image Container with Hover Zoom -->
                <div class="relative overflow-hidden bg-slate-950 h-64">
                  <img 
                    src={product.image} 
                    alt={product.title} 
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  />
                  <span class="absolute top-4 left-4 bg-slate-900/80 backdrop-blur-md text-blue-400 text-xs font-bold px-3 py-1 rounded-full border border-slate-700">
                    {product.category}
                  </span>
                </div>

                <!-- Product Body -->
                <div class="p-6">
                  <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">SKU: {product.sku}</span>
                  <h3 class="text-lg font-bold text-white mt-1 mb-4 leading-snug group-hover:text-blue-400 transition-colors">
                    {product.title}
                  </h3>

                  <!-- Spec Sheet Table -->
                  <div class="bg-slate-950/60 rounded-xl p-4 border border-slate-800/60 mb-6">
                    <ul class="text-xs space-y-2 font-mono">
                      {Object.entries(product.specs).map(([key, value]) => (
                        <li class="flex justify-between border-b border-slate-800/60 pb-1.5 last:border-0 last:pb-0">
                          <span class="text-slate-500 capitalize">{key.replace('_', ' ')}:</span>
                          <span class="font-semibold text-slate-200">{value}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Card Action Button -->
              <div class="px-6 pb-6 pt-0">
                <a 
                  href={`mailto:sales@bestbuylighting.com?subject=Inquiry regarding SKU: ${product.sku}`}
                  class="block w-full text-center bg-slate-800 hover:bg-blue-600 text-slate-200 hover:text-white font-semibold py-2.5 rounded-xl transition-all duration-300 border border-slate-700 hover:border-blue-500"
                >
                  Request Technical Spec & Quote
                </a>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- About & Quality Assurance Section -->
    <section id="about" class="py-20 bg-slate-900/50 border-t border-slate-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="text-blue-400 font-semibold text-sm tracking-wider uppercase">Engineering Standard</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-white mt-2 mb-6">Built for Commercial Durability & Optimal Photometrics</h2>
            <p class="text-slate-400 leading-relaxed mb-6">
              BestBuy Lighting Ltd delivers high-lumens-per-watt efficiency designed for warehouses, commercial properties, retail spaces, and exterior security.
            </p>
            
            <div class="space-y-4">
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-blue-500/10 text-blue-400 rounded-lg flex items-center justify-center font-bold mt-1">✓</div>
                <div>
                  <h4 class="font-bold text-white">Thermal Management & Heat Sinks</h4>
                  <p class="text-xs text-slate-400">High-grade aluminum extrusion housing minimizes lumen depreciation over long operational cycles.</p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-blue-500/10 text-blue-400 rounded-lg flex items-center justify-center font-bold mt-1">✓</div>
                <div>
                  <h4 class="font-bold text-white">Precision Optical Lenses</h4>
                  <p class="text-xs text-slate-400">Custom beam angles (60°, 90°, 120°) ensure uniform illumination without unwanted glare.</p>
                </div>
              </div>
            </div>
          </div>

          <div id="certifications" class="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-xl">
            <h3 class="text-xl font-bold text-white mb-6">Certifications & Quality Compliance</h3>
            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center">
                <span class="block text-2xl font-black text-blue-400 mb-1">CE / RoHS</span>
                <span class="text-xs text-slate-400">EU Safety Compliant</span>
              </div>
              <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center">
                <span class="block text-2xl font-black text-blue-400 mb-1">ISO 9001</span>
                <span class="text-xs text-slate-400">Quality Management</span>
              </div>
              <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center">
                <span class="block text-2xl font-black text-blue-400 mb-1">IP65 / IP66</span>
                <span class="text-xs text-slate-400">Ingress Protection</span>
              </div>
              <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center">
                <span class="block text-2xl font-black text-blue-400 mb-1">IK08 / IK10</span>
                <span class="text-xs text-slate-400">Impact Protection</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact & Inquiry Form -->
    <section id="contact" class="py-20 bg-slate-950 border-t border-slate-900">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Request a Wholesale Quote or Technical Datasheet</h2>
        <p class="text-slate-400 mb-8">Send us your project specifications, required quantities, or SKU inquiries.</p>

        <form action="mailto:sales@bestbuylighting.com" method="post" enctype="text/plain" class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-left shadow-xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Company / Contact Name</label>
              <input type="text" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="e.g. John Doe" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Email Address</label>
              <input type="email" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="name@company.com" />
            </div>
          </div>
          <div class="mb-6">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Product SKU / Inquiry Details</label>
            <textarea rows="4" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500 transition-colors" placeholder="Specify product SKUs, estimated volume, or custom photometric requirements..."></textarea>
          </div>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-blue-600/30 transition-all">
            Send Formal Inquiry
          </button>
        </form>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-900 py-12 text-center text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-4">
        <p class="font-semibold text-slate-400 mb-2">BestBuy Lighting Ltd</p>
        <p>© 2026 BestBuy Lighting Ltd. All rights reserved. High-Efficiency LED Lighting Catalog.</p>
      </div>
    </footer>

    <!-- Client-Side Tab Filtering Logic -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.product-card');

        buttons.forEach(button => {
          button.addEventListener('click', () => {
            const category = button.getAttribute('data-category');

            // Style active tab
            buttons.forEach(btn => {
              btn.classList.remove('bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-600/30');
              btn.classList.add('bg-slate-900', 'text-slate-400', 'border', 'border-slate-800');
            });
            button.classList.remove('bg-slate-900', 'text-slate-400', 'border', 'border-slate-800');
            button.classList.add('bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-600/30');

            // Filter Grid Items
            cards.forEach(card => {
              const cardCat = card.getAttribute('data-category');
              if (category === 'All' || cardCat === category) {
                card.style.display = 'flex';
                card.classList.add('animate-fade-in');
              } else {
                card.style.display = 'none';
                card.classList.remove('animate-fade-in');
              }
            });
          });
        });
      });
    </script>

  </body>
</html>