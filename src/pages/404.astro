---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | BestBuy Lighting">
  <div class="max-w-md mx-auto py-24 text-center px-4">
    <h1 class="text-6xl font-black text-blue-800 mb-4">404</h1>
    <h2 class="text-xl font-bold text-gray-800 mb-2">Page Not Found</h2>
    <p class="text-sm text-gray-600 mb-8">The requested category, file, or SKU parameter does not exist in our system.</p>
    <a href="/" class="bg-blue-800 text-white font-bold px-6 py-3 text-sm hover:bg-blue-700 transition-colors inline-block">
      Return to Homepage
    </a>
  </div>
</BaseLayout>